{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treq",
  "version": "../package.json",
  "identifier": "com.treq",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        { "scheme": ["treq"], "host": "auth", "pathPrefix": ["/callback"], "appLink": false }
      ],
      "desktop": { "schemes": ["treq"] }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "android": { "minSdkVersion": 28 }
  }
}
