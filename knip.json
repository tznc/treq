{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.stories.tsx!",
    "src/**/*.test.{ts,tsx}!",
    "test/**/*.{ts,tsx}!",
    "scripts/**/*.{js,mjs,ts}!",
    "eslint-rules/**/*.js!",
    "vitest*.config.ts!",
    ".storybook/{main,preview}.*"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx}",
    "test/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}",
    "eslint-rules/**/*.js",
    "*.config.{js,ts}",
    "vitest*.config.ts",
    ".storybook/**/*.{ts,tsx,js}"
  ],
  "ignore": [
    "src/dist/**",
    "src-tauri/**",
    "web/**",
    "supabase/**",
    "docs/**",
    "target/**"
  ],
  "ignoreBinaries": ["supabase", "sqlite3", "devcontainer"],
  "ignoreDependencies": [
    "@eslint/css",
    "@eslint/markdown",
    "@monaco-editor/react",
    "@napi-rs/cli",
    "@tauri-apps/plugin-cli",
    "@tauri-apps/plugin-deep-link",
    "@xterm/addon-clipboard",
    "monaco-editor",
    "react-hook-form",
    "vite-plugin-monaco-editor",
    "zod",
    "react-compiler-runtime"
  ],
  "rules": {
    "duplicates": "off"
  }
}
