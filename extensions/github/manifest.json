{
  "manifest_version": 3,
  "name": "Treq Enhancements for GitHub",
  "version": "0.1.0",
  "description": "Open GitHub repositories, pull requests and code lines in Claude, Codex or Treq.",
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
