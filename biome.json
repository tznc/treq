{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"files": {
		"includes": ["**"]
	},
	"formatter": {
		"indentStyle": "space",
		"indentWidth": 2
	},
	"linter": {
		"rules": {
			"style": {
				"noNonNullAssertion": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	}
}
