{
  "name": "treq",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "featureFlags": {
    "pro": true,
    "stripePayments": false,
    "emailSignup": false,
    "githubApp": true,
    "skillsInstallation": false,
    "remoteSsh": false,
    "devcontainers": false,
    "linearIntegration": false,
    "logs": true
  },
  "env": {
    "dev": {
      "webUrl": "http://localhost:3001",
      "supabase": {
        "url": "http://127.0.0.1:54321",
        "anonKey": "sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
      }
    },
    "prod": {
      "webUrl": "https://treq.dev",
      "supabase": {
        "url": "https://xnlljmfiqyumiyexydyl.supabase.co",
        "anonKey": "sb_publishable_pLkrXd6cs1V7Ot6Dnowmtw_KBgFf88E"
      }
    }
  },
  "scripts": {
    "start": "npm run tauri dev open",
    "tauri": "tauri",
    "clean": "cd src-tauri && cargo clean",
    "test": "vitest run",
    "service-qa:up": "bash scripts/service-qa/up.sh",
    "service-qa": "vitest run --config vitest.service-qa.config.ts",
    "service-qa:full": "npm run service-qa:up && npm run service-qa",
    "test:db": "supabase test db --local",
    "format": "biome format --write ./test && cargo fmt",
    "check:format": "biome format ./test",
    "check": "ast-grep test",
    "check:functions": "deno check supabase/functions/*/index.ts supabase/functions/tests/*.ts",
    "test:functions": "deno test --allow-env --allow-net=example.invalid supabase/functions/tests/remote_ssh_relay.test.ts supabase/functions/tests/remote_quota.test.ts supabase/functions/tests/remote_instance_store.test.ts",
    "lint": "ast-grep scan && biome lint ./test ./supabase/functions && npm run lint:subprocess && npm run lint:home-head && npm run lint:a11y && npm run lint:design",
    "lint:e2e": "ast-grep test --skip-snapshot-tests && ast-grep scan web/e2e",
    "lint:subprocess": "ast-grep scan --filter '^(no-command-for-jj-or-git-tauri-src|no-command-new-git-rust-tests|no-subprocess-conflict-pipeline-tauri-src)$'",
    "lint:home-head": "ast-grep scan --filter '^home-git-head-history-edit-needs-test$'",
    "lint:a11y": "ast-grep scan --filter '^gpui-control-needs-accessible-name$'",
    "lint:design": "ast-grep scan --filter '^(gpui-button-no-restyle|gpui-escape-via-layers|gpui-hover-token|gpui-no-adhoc-controls|gpui-no-adhoc-tabs|gpui-no-local-dialog|gpui-no-local-row|gpui-no-raw-color|gpui-no-raw-text-size|gpui-no-zpx-spacing|gpui-row-selected-token|ui-copy-no-yes-no)$'",
    "design:audit": "node scripts/design-audit.mjs",
    "icons:generate": "node scripts/generate-icons.js && npx @tauri-apps/cli icon assets/logo-white.imageset/logo-white-rounded.svg && node scripts/flatten-ios-icons.js"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.38.0",
    "@biomejs/biome": "2.4.7",
    "@supabase/supabase-js": "^2.95.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^20.10.5",
    "pngjs": "^7.0.0",
    "vitest": "^4.0.15"
  }
}
