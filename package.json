        "anonKey": "sb_publishable_pLkrXd6cs1V7Ot6Dnowmtw_KBgFf88E"
      }
    }
  },
  "scripts": {
    "start": "npm run tauri dev open",
    "dev": "vite",
    "build": "tsc && vite build && npm run verify:frontend-dist",
    "verify:frontend-dist": "node -e \"const fs=require('node:fs');const path='src/dist';if(!fs.existsSync(path)){console.error('Missing frontend build output at '+path);process.exit(1)}\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean": "cd src-tauri && cargo clean",
    "mobile:android:init": "tauri android init",
    "mobile:android:dev": "tauri android dev",
    "mobile:android:build": "tauri android build",
    "mobile:ios:init": "tauri ios init",
    "mobile:ios:dev": "tauri ios dev",
    "mobile:ios:build": "tauri ios build",
    "test:run": "npm run test:unit && npm run test:integration",
    "test:ui": "vitest --ui",
    "build:napi": "cargo build --manifest-path src-tauri/Cargo.toml --lib --features tauri-test",
    "test:unit": "vitest run --config vitest.unit.config.ts --silent=passed-only",
    "test:integration:run": "DEBUG_PRINT_LIMIT=10 vitest run --config vitest.integration.config.ts --silent=passed-only",
    "test:integration": "npm run build:napi --silent && npm run test:integration:run",
    "test": "npm run test:unit && npm run test:integration",
    "screenshot:css": "node scripts/screenshot/build-css.mjs",
    "screenshot": "npm run build:napi --silent && npm run screenshot:css && vitest run --config vitest.screenshot.config.ts",
    "screenshot:readme": "npm run build:napi --silent && npm run screenshot:css && vitest run --config vitest.screenshot.config.ts scripts/screenshot/specs/readme-*.spec.tsx",
    "screenshot:landing": "npm run screenshot:readme",
    "service-qa:up": "bash scripts/service-qa/up.sh",
    "service-qa": "vitest run --config vitest.service-qa.config.ts",
    "service-qa:full": "npm run service-qa:up && npm run service-qa",
    "test:db": "supabase test db --local",
    "format": "biome format  --write ./src ./test && cargo fmt",
    "check:format": "biome format ./src ./test",
    "check": "tsc && ast-grep test",
    "lint:e2e": "ast-grep test --skip-snapshot-tests && ast-grep scan web/e2e",
    "lint": "oxlint ./src ./test/integration && eslint ./src ./test/integration --quiet && ast-grep scan --warning && npm run lint:subprocess && npm run lint:home-head",
    "lint:subprocess": "ast-grep scan --filter '^(no-command-for-jj-or-git-tauri-src|no-command-new-git-rust-tests|no-subprocess-conflict-pipeline-tauri-src)$'",
    "lint:home-head": "ast-grep scan --filter '^home-git-head-history-edit-needs-test$'",
    "knip": "knip",
    "icons:generate": "node scripts/generate-icons.js && npx @tauri-apps/cli icon assets/logo-white.imageset/logo-white-rounded.svg",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:screenshot": "npm run build-storybook --silent && node scripts/storybook/screenshot.mjs"
  },
  "dependencies": {
